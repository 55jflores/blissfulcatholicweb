# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — from console.anthropic.com (used by the Claude proxy, wired in a later Phase 3 step)
ANTHROPIC_API_KEY=sk-ant-...

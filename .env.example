# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase — from your project's Settings → API → "Publishable and secret API keys"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic — from console.anthropic.com (used by the Claude proxy)
ANTHROPIC_API_KEY=sk-ant-...
